# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# Dev-only escape hatch (DO NOT use in prod)
AUTH_DISABLED=false

# --- Session cookie ---
SESSION_SECRET=change-me

# --- MySQL ---
DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ide_platform

# --- OIDC (Okta or Keycloak) ---
OIDC_ISSUER=https://your-idp.example.com/realms/your-realm
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- MCP server (stdio) ---
MCP_COMMAND=python3
MCP_ARGS=["-m","cloud_mcp_agent.server"]
MCP_CWD=

# --- AWS role mapping (comma-separated allow patterns) ---
# Example: arn:aws:iam::111111111111:role/OperatorReadOnly
AWS_ALLOWED_ROLE_ARNS=

# Default role if user has no group mapping (optional; prefer explicit mapping)
AWS_DEFAULT_ROLE_ARN=

# ExternalId for AssumeRole (optional)
AWS_ROLE_EXTERNAL_ID=
